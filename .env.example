# Copy this file to .env for local-only experiments.
# Never commit real keys.

# Local server
HOST=127.0.0.1
PORT=3001

# Example provider values for manual tests
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=paraformer-v2

# User-owned OSS for temporary audio transfer
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=
